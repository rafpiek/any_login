<script nonce="<%= content_security_policy_nonce %>">
  (function () {
    function parseJson(el, attr, fallback) {
      try {
        return JSON.parse(el.getAttribute(attr) || fallback);
      } catch (e) {
        return JSON.parse(fallback);
      }
    }

    function normalize(s) {
      return (s || "").toLowerCase().trim();
    }

    function fuzzyScore(query, label, id) {
      if (!query) return 1;
      var q = normalize(query);
      var l = normalize(label);
      var i = normalize(id);
      if (l.indexOf(q) !== -1 || i.indexOf(q) !== -1) return 100 - l.indexOf(q);
      var qi = 0;
      for (var li = 0; li < l.length && qi < q.length; li++) {
        if (l[li] === q[qi]) qi++;
      }
      if (qi === q.length) return 50;
      return 0;
    }


    function focusActivePanelInput(root) {
      var panel = root.querySelector(".any_login_tabpanel.is-active");
      if (!panel) return;
      var key = panel.getAttribute("data-any-login-panel");
      var el =
        key === "users"
          ? root.querySelector("#any_login_user_search")
          : key === "id"
            ? root.querySelector("#any_login_id_input")
            : null;
      if (el) el.focus({ preventScroll: true });
    }

    function setActiveTab(root, tabKey) {
      var tabs = root.querySelectorAll("[data-any-login-tab]");
      var panels = root.querySelectorAll("[data-any-login-panel]");
      tabs.forEach(function (btn) {
        var active = btn.getAttribute("data-any-login-tab") === tabKey;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-selected", active ? "true" : "false");
        btn.tabIndex = active ? 0 : -1;
      });
      panels.forEach(function (panel) {
        var active = panel.getAttribute("data-any-login-panel") === tabKey;
        panel.classList.toggle("is-active", active);
        if (active) panel.removeAttribute("hidden");
        else panel.setAttribute("hidden", "hidden");
      });
      var toggle = root.querySelector("#any_login_form_toggle");
      if (toggle && toggle.checked) {
        requestAnimationFrame(function () {
          focusActivePanelInput(root);
        });
      }
    }

    function renderUserList(root, users, query, listEl, emptyEl, highlightIndex) {
      listEl.innerHTML = "";
      var scored = users
        .map(function (u) {
          return { u: u, score: fuzzyScore(query, u.label, u.id) };
        })
        .filter(function (x) {
          return x.score > 0;
        })
        .sort(function (a, b) {
          return b.score - a.score;
        });

      var showGroups = !query && users.some(function (u) {
        return u.group;
      });
      var lastGroup = null;

      if (scored.length === 0) {
        emptyEl.hidden = false;
        return [];
      }
      emptyEl.hidden = true;

      var options = [];
      scored.forEach(function (item, idx) {
        var u = item.u;
        if (showGroups && u.group && u.group !== lastGroup) {
          lastGroup = u.group;
          var gh = document.createElement("li");
          gh.className = "any_login_list_group";
          gh.textContent = u.group;
          gh.setAttribute("role", "presentation");
          listEl.appendChild(gh);
        }

        var li = document.createElement("li");
        li.setAttribute("role", "presentation");
        var btn = document.createElement("button");
        btn.type = "submit";
        btn.name = "selected_id";
        btn.setAttribute("form", "any_login_form");
        btn.value = u.id;
        btn.className = "any_login_list_option";
        btn.setAttribute("role", "option");
        btn.setAttribute("data-user-id", u.id);
        if (idx === highlightIndex) btn.classList.add("is-highlighted");

        var label = document.createElement("span");
        label.className = "any_login_list_option_label";
        label.textContent = u.label;
        btn.appendChild(label);

        if (query && u.group) {
          var badge = document.createElement("span");
          badge.className = "any_login_list_option_badge";
          badge.textContent = u.group;
          btn.appendChild(badge);
        }

        btn.addEventListener("click", function (event) {
          if (!btn.form || !btn.form.requestSubmit) return;
          event.preventDefault();
          btn.form.requestSubmit(btn);
        });
        li.appendChild(btn);
        listEl.appendChild(li);
        options.push(btn);
      });
      return options;
    }

    function renderRecentList(root, recent, listEl, emptyEl) {
      listEl.innerHTML = "";
      if (!recent.length) {
        emptyEl.hidden = false;
        return;
      }
      emptyEl.hidden = true;
      recent.forEach(function (u) {
        var li = document.createElement("li");
        li.setAttribute("role", "listitem");
        var btn = document.createElement("button");
        btn.type = "submit";
        btn.name = "back_to_previous_id";
        btn.setAttribute("form", "any_login_form");
        btn.value = u.id;
        btn.className = "any_login_list_option";
        var label = document.createElement("span");
        btn.addEventListener("click", function (event) {
          if (!btn.form || !btn.form.requestSubmit) return;
          event.preventDefault();
          btn.form.requestSubmit(btn);
        });
        label.className = "any_login_list_option_label";
        label.textContent = u.label;
        btn.appendChild(label);
        li.appendChild(btn);
        listEl.appendChild(li);
      });
    }

    function setupTabs(root) {
      setActiveTab(root, root.getAttribute("data-any-login-default-tab") || "users");

      root.querySelectorAll("[data-any-login-tab]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          setActiveTab(root, btn.getAttribute("data-any-login-tab"));
        });
      });
    }

    function setupUsersCombobox(root, users) {
      var search = root.querySelector("#any_login_user_search");
      var list = root.querySelector("#any_login_user_list");
      var empty = root.querySelector(".any_login_users_empty");
      if (!search || !list) return;

      var highlight = 0;
      var optionButtons = [];

      function refresh() {
        optionButtons = renderUserList(root, users, search.value, list, empty, highlight);
        highlight = Math.min(highlight, Math.max(0, optionButtons.length - 1));
      }

      search.addEventListener("input", function () {
        highlight = 0;
        refresh();
      });

      search.addEventListener("keydown", function (e) {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          highlight = Math.min(highlight + 1, optionButtons.length - 1);
          refresh();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          highlight = Math.max(highlight - 1, 0);
          refresh();
        } else if (e.key === "Enter") {
          if (optionButtons[highlight]) {
            e.preventDefault();
            optionButtons[highlight].click();
          }
        }
      });

    }

    function setupPanel(root) {
      var toggle = root.querySelector("#any_login_form_toggle");
      if (!toggle) return;

      function onOpen() {
        if (!toggle.checked) return;
        setActiveTab(root, root.getAttribute("data-any-login-default-tab") || "users");
      }

      toggle.addEventListener("change", onOpen);
      onOpen();

      if (root.getAttribute("data-any-login-dismiss") === "true") return;
      root.setAttribute("data-any-login-dismiss", "true");

      document.addEventListener("click", function (event) {
        if (!toggle.checked || root.contains(event.target)) return;
        toggle.checked = false;
      });

      document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape" || !toggle.checked) return;
        var search = root.querySelector("#any_login_user_search");
        if (search && document.activeElement === search && search.value) {
          search.value = "";
          search.dispatchEvent(new Event("input"));
          return;
        }
        toggle.checked = false;
      });
    }

    function initRoot(root) {
      if (root.getAttribute("data-any-login-ready") === "true") return;
      root.setAttribute("data-any-login-ready", "true");

      var users = parseJson(root, "data-any-login-users", "[]");
      var recent = parseJson(root, "data-any-login-recent", "[]");

      setupTabs(root);
      setupUsersCombobox(root, users);

      var recentList = root.querySelector("#any_login_recent_list");
      var recentEmpty = root.querySelector(".any_login_recent_empty");
      if (recentList && recentEmpty) renderRecentList(root, recent, recentList, recentEmpty);

      setupPanel(root);
    }

    function setupKeyboardShortcut() {
      if (document.documentElement.getAttribute("data-any-login-shortcut")) return;
      document.documentElement.setAttribute("data-any-login-shortcut", "true");

      document.addEventListener("keydown", function (event) {
        var key = event.key && event.key.toLowerCase();
        if (key !== "l" || !event.shiftKey) return;
        if (!event.ctrlKey && !event.metaKey) return;

        var root = document.querySelector("[data-any-login]");
        if (!root) return;

        var toggle = root.querySelector("#any_login_form_toggle");
        if (!toggle) return;

        event.preventDefault();
        toggle.checked = !toggle.checked;
        toggle.dispatchEvent(new Event("change", { bubbles: true }));
      });
    }

    function boot() {
      document.querySelectorAll("[data-any-login]").forEach(initRoot);
      setupKeyboardShortcut();
    }

    ["DOMContentLoaded", "turbolinks:load", "turbo:load"].forEach(function (e) {
      window.addEventListener(e, boot);
    });
  })();
</script>