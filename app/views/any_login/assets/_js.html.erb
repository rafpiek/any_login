<script nonce="<%= content_security_policy_nonce %>">
  (function () {
    function normalize(value) {
      return (value || "").toLowerCase().trim();
    }

    function focusActivePanelInput(root) {
      var panel = root.querySelector(".any_login_tabpanel.is-active");
      if (!panel) return;

      var selectorByPanel = {
        users: "#any_login_user_search",
        id: "#any_login_id_input"
      };
      var selector = selectorByPanel[panel.getAttribute("data-any-login-panel")];
      var input = selector && root.querySelector(selector);
      if (input) input.focus({ preventScroll: true });
    }

    function setActiveTab(root, tabKey) {
      root.querySelectorAll("[data-any-login-tab]").forEach(function (btn) {
        var active = btn.getAttribute("data-any-login-tab") === tabKey;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-selected", active ? "true" : "false");
        btn.tabIndex = active ? 0 : -1;
      });

      root.querySelectorAll("[data-any-login-panel]").forEach(function (panel) {
        var active = panel.getAttribute("data-any-login-panel") === tabKey;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });

      var toggle = root.querySelector("#any_login_form_toggle");
      if (toggle && toggle.checked) {
        requestAnimationFrame(function () {
          focusActivePanelInput(root);
        });
      }
    }

    function setupTabs(root) {
      setActiveTab(root, root.getAttribute("data-any-login-default-tab") || "users");

      root.querySelectorAll("[data-any-login-tab]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          setActiveTab(root, btn.getAttribute("data-any-login-tab"));
        });
      });
    }

    function setupUsersCombobox(root) {
      var search = root.querySelector("#any_login_user_search");
      var empty = root.querySelector(".any_login_users_empty");
      var userItems = Array.prototype.slice.call(root.querySelectorAll("[data-any-login-user]"));
      if (!search || !empty || !userItems.length) return;

      var visibleButtons = [];
      var highlight = 0;

      function applyHighlight() {
        visibleButtons.forEach(function (btn, index) {
          btn.classList.toggle("is-highlighted", index === highlight);
        });
      }

      function refresh() {
        var query = normalize(search.value);
        visibleButtons = [];

        userItems.forEach(function (item) {
          var button = item.querySelector(".any_login_list_option");
          var matches = !query || normalize(button.getAttribute("data-search")).indexOf(query) !== -1;
          item.hidden = !matches;
          if (matches) visibleButtons.push(button);
        });

        highlight = Math.min(highlight, Math.max(0, visibleButtons.length - 1));
        empty.hidden = visibleButtons.length > 0;
        applyHighlight();
      }

      search.addEventListener("input", function () {
        highlight = 0;
        refresh();
      });

      search.addEventListener("keydown", function (event) {
        if (!visibleButtons.length && event.key !== "Enter") return;
        if (event.key === "ArrowDown") {
          event.preventDefault();
          highlight = Math.min(highlight + 1, visibleButtons.length - 1);
          applyHighlight();
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          highlight = Math.max(highlight - 1, 0);
          applyHighlight();
        } else if (event.key === "Enter" && visibleButtons[highlight]) {
          event.preventDefault();
          visibleButtons[highlight].click();
        }
      });

      refresh();
    }

    function setupPanel(root) {
      var toggle = root.querySelector("#any_login_form_toggle");
      if (!toggle) return;

      function onOpen() {
        if (!toggle.checked) return;
        setActiveTab(root, root.getAttribute("data-any-login-default-tab") || "users");
      }

      toggle.addEventListener("change", onOpen);
      onOpen();

      if (root.getAttribute("data-any-login-dismiss") === "true") return;
      root.setAttribute("data-any-login-dismiss", "true");

      document.addEventListener("click", function (event) {
        if (!toggle.checked || root.contains(event.target)) return;
        toggle.checked = false;
      });

      document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape" || !toggle.checked) return;

        var search = root.querySelector("#any_login_user_search");
        if (search && document.activeElement === search && search.value) {
          search.value = "";
          search.dispatchEvent(new Event("input"));
          return;
        }

        toggle.checked = false;
      });
    }

    function setupSubmitButtons(root) {
      root.addEventListener("click", function (event) {
        var button = event.target.closest(".any_login_list_option");
        if (!button || !root.contains(button) || !button.form || !button.form.requestSubmit) return;

        event.preventDefault();
        button.form.requestSubmit(button);
      });
    }

    function initRoot(root) {
      if (root.getAttribute("data-any-login-ready") === "true") return;
      root.setAttribute("data-any-login-ready", "true");
      setupTabs(root);
      setupUsersCombobox(root);
      setupSubmitButtons(root);
      setupPanel(root);
    }

    function setupKeyboardShortcut() {
      if (document.documentElement.getAttribute("data-any-login-shortcut")) return;
      document.documentElement.setAttribute("data-any-login-shortcut", "true");

      document.addEventListener("keydown", function (event) {
        var key = event.key && event.key.toLowerCase();
        if (key !== "l" || !event.shiftKey) return;
        if (!event.ctrlKey && !event.metaKey) return;

        var root = document.querySelector("[data-any-login]");
        if (!root) return;

        var toggle = root.querySelector("#any_login_form_toggle");
        if (!toggle) return;

        event.preventDefault();
        toggle.checked = !toggle.checked;
        toggle.dispatchEvent(new Event("change", { bubbles: true }));
      });
    }

    function boot() {
      document.querySelectorAll("[data-any-login]").forEach(initRoot);
      setupKeyboardShortcut();
    }

    ["DOMContentLoaded", "turbolinks:load", "turbo:load"].forEach(function (eventName) {
      window.addEventListener(eventName, boot);
    });
  })();
</script>