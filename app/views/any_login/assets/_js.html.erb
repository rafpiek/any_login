<script nonce="<%= content_security_policy_nonce %>">
  (function () {
    function normalize(value) {
      return (value || "").toLowerCase().trim();
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, function (ch) {
        return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch];
      });
    }

    function focusActivePanelInput(root) {
      var panel = root.querySelector(".any_login_tabpanel.is-active");
      if (!panel) return;

      var selectorByPanel = {
        users: "#any_login_user_search",
        id: "#any_login_id_input"
      };
      var selector = selectorByPanel[panel.getAttribute("data-any-login-panel")];
      var input = selector && root.querySelector(selector);
      if (input) input.focus({ preventScroll: true });
    }

    function setActiveTab(root, tabKey) {
      root.querySelectorAll("[data-any-login-tab]").forEach(function (btn) {
        var active = btn.getAttribute("data-any-login-tab") === tabKey;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-selected", active ? "true" : "false");
        btn.tabIndex = active ? 0 : -1;
      });

      root.querySelectorAll("[data-any-login-panel]").forEach(function (panel) {
        var active = panel.getAttribute("data-any-login-panel") === tabKey;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });

      var toggle = root.querySelector("#any_login_form_toggle");
      if (toggle && toggle.checked) {
        requestAnimationFrame(function () {
          focusActivePanelInput(root);
        });
      }
    }

    function setupTabs(root) {
      setActiveTab(root, root.getAttribute("data-any-login-default-tab") || "users");

      root.querySelectorAll("[data-any-login-tab]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          setActiveTab(root, btn.getAttribute("data-any-login-tab"));
        });
      });
    }

    function setupUsersCombobox(root) {
      var search = root.querySelector("#any_login_user_search");
      var empty = root.querySelector(".any_login_users_empty");
      var list = root.querySelector("#any_login_user_list");
      var usersPath = root.getAttribute("data-any-login-users-path");
      if (!search || !empty || !list) return;

      var originalHtml = list.innerHTML;
      var userItems = [];
      var visibleButtons = [];
      var highlight = 0;
      var timer = null;
      var requestId = 0;

      function collectItems() {
        userItems = Array.prototype.slice.call(list.querySelectorAll("[data-any-login-user]"));
      }

      function applyHighlight() {
        visibleButtons.forEach(function (btn, index) {
          btn.classList.toggle("is-highlighted", index === highlight);
        });
      }

      function refresh() {
        var query = normalize(search.value);
        visibleButtons = [];

        userItems.forEach(function (item) {
          var button = item.querySelector(".any_login_list_option");
          var haystack = button ? button.getAttribute("data-search") : "";
          var matches = !query || normalize(haystack).indexOf(query) !== -1;
          item.hidden = !matches;
          if (matches && button) visibleButtons.push(button);
        });

        highlight = Math.min(highlight, Math.max(0, visibleButtons.length - 1));
        empty.hidden = visibleButtons.length > 0;
        applyHighlight();
      }

      function restoreOriginal() {
        list.innerHTML = originalHtml;
        collectItems();
        refresh();
      }

      function renderUsers(users) {
        list.innerHTML = (users || []).map(function (user) {
          var id = escapeHtml(String(user.id));
          var label = escapeHtml(String(user.label || ""));
          var group = user.group ? escapeHtml(String(user.group)) : "";
          var searchText = escapeHtml([user.label, user.id, user.group].filter(Boolean).join(" "));
          return '<li role="presentation" data-any-login-user>' +
            '<button type="submit" name="selected_id" value="' + id + '" class="any_login_list_option" role="option" data-user-id="' + id + '" data-search="' + searchText + '">' +
            '<span class="any_login_list_option_label">' + label + '</span>' +
            (group ? '<span class="any_login_list_option_badge">' + group + '</span>' : "") +
            "</button></li>";
        }).join("");
        collectItems();
        visibleButtons = userItems.map(function (item) {
          return item.querySelector(".any_login_list_option");
        }).filter(Boolean);
        highlight = 0;
        empty.hidden = visibleButtons.length > 0;
        applyHighlight();
      }

      function searchRemote(query) {
        if (!usersPath) {
          collectItems();
          refresh();
          return;
        }

        var id = ++requestId;
        fetch(usersPath + "?q=" + encodeURIComponent(query), {
          headers: { Accept: "application/json" },
          credentials: "same-origin"
        }).then(function (res) {
          return res.ok ? res.json() : Promise.reject();
        }).then(function (data) {
          if (id !== requestId) return;
          renderUsers(data && data.users);
        }).catch(function () {
          if (id !== requestId) return;
          renderUsers([]);
        });
      }

      collectItems();

      search.addEventListener("input", function () {
        highlight = 0;
        var query = normalize(search.value);
        if (!query) {
          clearTimeout(timer);
          requestId += 1;
          restoreOriginal();
          return;
        }

        if (!usersPath) {
          refresh();
          return;
        }

        clearTimeout(timer);
        timer = setTimeout(function () {
          searchRemote(search.value);
        }, 200);
      });

      search.addEventListener("keydown", function (event) {
        if (!visibleButtons.length && event.key !== "Enter") return;
        if (event.key === "ArrowDown") {
          event.preventDefault();
          highlight = Math.min(highlight + 1, visibleButtons.length - 1);
          applyHighlight();
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          highlight = Math.max(highlight - 1, 0);
          applyHighlight();
        } else if (event.key === "Enter" && visibleButtons[highlight]) {
          event.preventDefault();
          visibleButtons[highlight].click();
        }
      });

      refresh();
    }

    function setupPinned(root) {
      var list = root.querySelector("#any_login_pinned_list");
      var empty = root.querySelector(".any_login_pinned_empty");
      var pinButton = root.querySelector("[data-any-login-pin]");
      var storageKey = root.getAttribute("data-any-login-storage-key") || "any_login_pinned";
      if (!list || !empty) return;

      function readPins() {
        try {
          var parsed = JSON.parse(window.localStorage.getItem(storageKey) || "[]");
          return Array.isArray(parsed) ? parsed : [];
        } catch (e) {
          return [];
        }
      }

      function writePins(pins) {
        window.localStorage.setItem(storageKey, JSON.stringify(pins));
      }

      function currentUser() {
        var info = root.querySelector(".any_login_user_information");
        if (!info) return null;
        var id = info.getAttribute("data-any-login-current-id");
        if (!id) return null;
        return { id: String(id), label: info.getAttribute("data-any-login-current-label") || String(id) };
      }

      function isPinned(id) {
        return readPins().some(function (pin) {
          return String(pin.id) === String(id);
        });
      }

      function updatePinButton() {
        if (!pinButton) return;
        var user = currentUser();
        if (!user) {
          pinButton.hidden = true;
          return;
        }
        var pinned = isPinned(user.id);
        pinButton.hidden = false;
        pinButton.textContent = pinned ? "Unpin" : "Pin";
        pinButton.setAttribute("aria-pressed", pinned ? "true" : "false");
      }

      function renderPins() {
        var pins = readPins();
        list.innerHTML = pins.map(function (pin) {
          var id = escapeHtml(String(pin.id));
          var label = escapeHtml(String(pin.label || pin.id));
          return '<li class="any_login_pinned_row" role="listitem">' +
            '<button type="submit" name="selected_id" value="' + id + '" class="any_login_list_option" data-any-login-pinned-id="' + id + '">' +
            '<span class="any_login_list_option_label">' + label + '</span>' +
            "</button>" +
            '<button type="button" class="any_login_unpin_button" data-any-login-unpin="' + id + '" aria-label="Unpin user">&times;</button>' +
            "</li>";
        }).join("");
        empty.hidden = pins.length > 0;
        updatePinButton();
      }

      if (pinButton) {
        pinButton.addEventListener("click", function () {
          var user = currentUser();
          if (!user) return;
          var pins = isPinned(user.id)
            ? readPins().filter(function (pin) { return String(pin.id) !== user.id; })
            : [{ id: user.id, label: user.label }].concat(
                readPins().filter(function (pin) { return String(pin.id) !== user.id; })
              );
          writePins(pins);
          renderPins();
        });
      }

      list.addEventListener("click", function (event) {
        var unpin = event.target.closest("[data-any-login-unpin]");
        if (!unpin) return;
        event.preventDefault();
        event.stopPropagation();
        var id = unpin.getAttribute("data-any-login-unpin");
        writePins(readPins().filter(function (pin) { return String(pin.id) !== String(id); }));
        renderPins();
      });

      renderPins();
    }

    function setupPanel(root) {
      var toggle = root.querySelector("#any_login_form_toggle");
      if (!toggle) return;

      function onOpen() {
        if (!toggle.checked) return;
        setActiveTab(root, root.getAttribute("data-any-login-default-tab") || "users");
      }

      toggle.addEventListener("change", onOpen);
      onOpen();

      if (root.getAttribute("data-any-login-dismiss") === "true") return;
      root.setAttribute("data-any-login-dismiss", "true");

      document.addEventListener("click", function (event) {
        if (!toggle.checked || root.contains(event.target)) return;
        toggle.checked = false;
      });

      document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape" || !toggle.checked) return;

        var search = root.querySelector("#any_login_user_search");
        if (search && document.activeElement === search && search.value) {
          search.value = "";
          search.dispatchEvent(new Event("input"));
          return;
        }

        toggle.checked = false;
      });
    }

    function initRoot(root) {
      if (root.getAttribute("data-any-login-ready") === "true") return;
      root.setAttribute("data-any-login-ready", "true");
      setupTabs(root);
      setupUsersCombobox(root);
      setupPinned(root);
      setupPanel(root);
    }

    function setupKeyboardShortcut() {
      if (document.documentElement.getAttribute("data-any-login-shortcut")) return;
      document.documentElement.setAttribute("data-any-login-shortcut", "true");

      document.addEventListener("keydown", function (event) {
        var key = event.key && event.key.toLowerCase();
        if (key !== "l" || !event.shiftKey) return;
        if (!event.ctrlKey && !event.metaKey) return;

        var root = document.querySelector("[data-any-login]");
        if (!root) return;

        var toggle = root.querySelector("#any_login_form_toggle");
        if (!toggle) return;

        event.preventDefault();
        toggle.checked = !toggle.checked;
        toggle.dispatchEvent(new Event("change", { bubbles: true }));
      });
    }

    function boot() {
      document.querySelectorAll("[data-any-login]").forEach(initRoot);
      setupKeyboardShortcut();
    }

    ["DOMContentLoaded", "turbolinks:load", "turbo:load"].forEach(function (eventName) {
      window.addEventListener(eventName, boot);
    });
  })();
</script>
