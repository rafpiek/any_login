<style nonce="<%= content_security_policy_nonce %>">
  #any_login {
    --any-login-bg: #18181b;
    --any-login-surface: #27272a;
    --any-login-surface-hover: #323238;
    --any-login-border: #3f3f46;
    --any-login-text: #fafafa;
    --any-login-muted: #a1a1aa;
    --any-login-accent: #3b82f6;
    --any-login-accent-hover: #2563eb;
    --any-login-radius: 12px;
    --any-login-fab-size: 44px;
    position: fixed;
    z-index: 2147483000;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    line-height: 1.45;
    color: var(--any-login-text);
    pointer-events: none;
  }

  #any_login * {
    box-sizing: border-box;
  }

  #any_login form {
    margin: 0;
    padding: 0;
    pointer-events: auto;
  }

  #any_login .any_login_toggle_input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  #any_login .any_login_fab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--any-login-fab-size);
    height: var(--any-login-fab-size);
    border-radius: 9999px;
    background: var(--any-login-bg);
    border: 1px solid var(--any-login-border);
    box-shadow: none;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  #any_login .any_login_fab:hover {
    border-color: #52525b;
    background: var(--any-login-surface);
  }

  #any_login .any_login_fab svg {
    width: 20px;
    height: 20px;
    fill: var(--any-login-text);
    pointer-events: none;
  }

  #any_login .any_login_panel {
    display: none;
    flex-direction: column;
    width: min(340px, calc(100vw - 24px));
    margin-bottom: 8px;
    background: var(--any-login-bg);
    border: 1px solid var(--any-login-border);
    border-radius: var(--any-login-radius);
    box-shadow: none;
    overflow: hidden;
  }

  #any_login .any_login_toggle_input:checked ~ .any_login_panel {
    display: flex;
  }

  #any_login.any_login_bottom_left form,
  #any_login.any_login_bottom_right form {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
  }

  #any_login.any_login_bottom_right form {
    align-items: flex-end;
  }

  #any_login.any_login_top_left form,
  #any_login.any_login_top_right form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #any_login.any_login_top_right form {
    align-items: flex-end;
  }

  #any_login.any_login_top_left .any_login_panel,
  #any_login.any_login_top_right .any_login_panel {
    margin-bottom: 0;
    margin-top: 10px;
  }

  #any_login.any_login_bottom_left,
  #any_login.any_login_bottom_right {
    bottom: 16px;
  }

  #any_login.any_login_bottom_left {
    left: 16px;
  }

  #any_login.any_login_bottom_right {
    right: 16px;
  }

  #any_login.any_login_top_left,
  #any_login.any_login_top_right {
    top: 16px;
  }

  #any_login.any_login_top_left {
    left: 16px;
  }

  #any_login.any_login_top_right {
    right: 16px;
  }

  #any_login .any_login_panel_header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background: var(--any-login-bg);
    border-bottom: 1px solid var(--any-login-border);
  }

  #any_login .any_login_panel_title {
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--any-login-muted);
  }

  #any_login .any_login_panel_close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    color: var(--any-login-muted);
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
  }

  #any_login .any_login_panel_close:hover {
    background: var(--any-login-surface-hover);
    color: var(--any-login-text);
  }

  #any_login .any_login_tabs {
    display: flex;
    gap: 0;
    padding: 0 8px;
    border-bottom: 1px solid var(--any-login-border);
    background: var(--any-login-bg);
  }

  #any_login .any_login_tab {
    flex: 1;
    margin: 0;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--any-login-muted);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.12s ease, border-color 0.12s ease;
  }

  #any_login .any_login_tab:hover {
    color: var(--any-login-text);
  }

  #any_login .any_login_tab.is-active {
    color: var(--any-login-text);
    border-bottom-color: var(--any-login-accent);
  }

  #any_login .any_login_panel_body {
    padding: 12px 14px;
    min-height: 140px;
  }

  #any_login .any_login_tabpanel {
    display: none;
    flex-direction: column;
    gap: 10px;
  }

  #any_login .any_login_tabpanel.is-active {
    display: flex;
  }

  #any_login .any_login_tabpanel[hidden] {
    display: none !important;
  }

  #any_login .any_login_label {
    font-size: 11px;
    font-weight: 500;
    color: var(--any-login-muted);
    margin-bottom: 6px;
    display: block;
  }

  #any_login .any_login_field {
    display: flex;
    flex-direction: column;
  }

  #any_login .any_login_search_input,
  #any_login #any_login_id_input {
    width: 100%;
    min-height: 38px;
    padding: 9px 11px;
    border-radius: 10px;
    border: 1px solid var(--any-login-border);
    background: var(--any-login-surface);
    color: var(--any-login-text);
    font-size: 13px;
    outline: none;
    transition: border-color 0.12s ease;
  }

  #any_login .any_login_search_input:focus,
  #any_login #any_login_id_input:focus {
    border-color: var(--any-login-accent);
  }

  #any_login #any_login_id_input {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
  }
  #any_login .any_login_combobox .any_login_listbox {
    margin-top: 8px;
  }

  #any_login .any_login_listbox,
  #any_login .any_login_recent_list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 200px;
    overflow-y: auto;
    border: none;
    border-radius: 0;
    background: transparent;
  }

  #any_login .any_login_list_group {
    padding: 6px 8px 4px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--any-login-muted);
  }

  #any_login .any_login_list_option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    margin: 0;
    padding: 9px 10px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--any-login-text);
    font-size: 13px;
    text-align: left;
    cursor: pointer;
    transition: background 0.1s ease;
  }

  #any_login .any_login_list_option:hover,
  #any_login .any_login_list_option.is-highlighted {
    background: var(--any-login-surface-hover);
  }

  #any_login .any_login_list_option_label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #any_login .any_login_list_option_badge {
    flex-shrink: 0;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    background: #3f3f46;
    color: var(--any-login-muted);
  }

  #any_login .any_login_empty {
    margin: 10px 0 0;
    font-size: 12px;
    color: var(--any-login-muted);
    text-align: center;
  }

  #any_login .any_login_actions input[type="submit"] {
    width: 100%;
    min-height: 38px;
    margin-top: 4px;
    padding: 9px 14px;
    border: none;
    border-radius: 10px;
    background: var(--any-login-accent);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  #any_login .any_login_actions input[type="submit"]:hover {
    background: var(--any-login-accent-hover);
  }

  #any_login .any_login_session_strip {
    padding: 10px 14px 12px;
    border-top: 1px solid var(--any-login-border);
    background: rgba(39, 39, 42, 0.6);
  }

  #any_login .any_login_session_strip:empty {
    display: none;
  }

  #any_login .any_login_user_information {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 12px;
  }

  #any_login .any_login_session_label {
    color: var(--any-login-text);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #any_login .any_login_session_id {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    color: var(--any-login-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #any_login[data-any-login-multi-tabs="false"] .any_login_tabs {
    display: none;
  }
</style>